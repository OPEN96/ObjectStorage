# 复制为 .env 后填写，docker compose 会自动读取。
# 注意：.env 含密钥，已在 .gitignore / .dockerignore 中排除。

# 管理端登录令牌：控制台 /admin 登录用，也接受 Bearer 头调用管理 API。
# 至少 32 位随机字符，生成方式：openssl rand -base64 48
ADMIN_TOKEN=change-me-to-a-long-random-string

# 初始 S3 访问密钥：仅在元数据库为空（首次启动）时写入。
# Secret 至少 16 位，生成方式：openssl rand -base64 36
# 启动后可在管理端「访问密钥」页面创建、禁用、删除其它密钥。
S3_ACCESS_KEY=AKIAEXAMPLELOCAL001
S3_SECRET_KEY=change-me-to-a-long-random-secret

# 对外端口与区域
S3_PORT=9000
S3_REGION=us-east-1

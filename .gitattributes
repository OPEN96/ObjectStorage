# 统一换行符，避免 Windows / Linux / macOS 提交互相污染
* text=auto eol=lf

*.slnx   text eol=lf
*.cs     text eol=lf diff=csharp
*.csproj text eol=lf
*.props  text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.md     text eol=lf
*.sh     text eol=lf

# 二进制资源
*.png binary
*.jpg binary
*.ico binary
*.zip binary

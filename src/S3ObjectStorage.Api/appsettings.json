{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "S3ObjectStorage": "Information"
    }
  },
  "AllowedHosts": "*",
  "Admin": {
    "Enabled": true,
    "SessionHours": 12
  },
  "ReverseProxy": {
    "Enabled": false,
    "KnownProxies": [],
    "ForwardLimit": 1
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:9000"
      }
    }
  },
  "S3": {
    "Region": "us-east-1",
    "EnforceRegion": false,
    "TimestampSkewSeconds": 900,
    "VirtualHostSuffix": "",
    "RequireAuthentication": true,
    "MaxKeyLength": 1024
  },
  "Storage": {
    "RootPath": "data/objectstorage",
    "VerifyPayloadHash": true,
    "MaxSinglePutBytes": 0,
    "BufferSize": 131072,
    "BootstrapAccessKeys": []
  }
}
